# Copy to .env (ignored) and replace the placeholders. Loaded by .envrc via direnv.
# Leave a line commented out to keep the default.

# Azure CLI profile for this project. Default from .envrc: $HOME/.azure-powerplatform-dev
# AZURE_CONFIG_DIR=/Users/<user>/.azure-<profile>

# Preselects this account when FlowAgent signs in for connection management.
# PA_LOGIN_HINT=<user>@<dev-tenant>.onmicrosoft.com

# Tenant used by FlowAgent's connectivity sign-in.
# PA_TENANT_ID=<dev-tenant-id>
